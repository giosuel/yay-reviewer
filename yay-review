#!/bin/bash
# yay with every AUR build file reviewed by Claude (see aur-review) before building.
# No args = full system upgrade (yay -Syu). Any yay args work, e.g.:
#   aur-update -S somepkg      aur-update --ignore foo,bar
# Uses the aur-review next to this script's real location, so it works both
# from /usr/bin (AUR package) and through the ~/.local/bin symlinks (install.sh).
here="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
exec yay --editmenu --answeredit All --editor "$here/aur-review" "$@"
