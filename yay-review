#!/bin/bash
# yay-review: use it exactly like yay, e.g.
#   yay-review              (= yay -Syu)
#   yay-review -S somepkg
#   yay-review -Syu --ignore foo
# Before yay builds any AUR package (new installs and upgrades), Claude reviews
# its build files through yay's edit menu (see yay-reviewer-hook). Nothing is built
# unless every package is approved.

# yay-reviewer-hook sits next to this script in a clone (also through install.sh's
# symlinks), and in /usr/lib/yay-reviewer/ when installed as a package.
here="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
for hook in "$here/yay-reviewer-hook" /usr/lib/yay-reviewer/yay-reviewer-hook; do
    [[ -x "$hook" ]] && break
done
if [[ ! -x "$hook" ]]; then
    echo "yay-review: cannot find yay-reviewer-hook (looked in $here and /usr/lib/yay-reviewer)" >&2
    exit 1
fi

exec yay --editmenu --answeredit All --editor "$hook" "$@"
