#!/bin/bash
# yay-review: use it exactly like yay, e.g.
#   yay-review              (= yay -Syu)
#   yay-review -S somepkg
#   yay-review -Syu --ignore foo
# Before yay builds any AUR package (new installs and upgrades), Claude reviews
# its build files through yay's edit menu (see aur-review). Nothing is built
# unless every package is approved.

# aur-review sits next to this script in a clone (also through install.sh's
# symlinks), and in /usr/lib/aur-reviewer/ when installed as a package.
here="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
for hook in "$here/aur-review" /usr/lib/aur-reviewer/aur-review; do
    [[ -x "$hook" ]] && break
done
if [[ ! -x "$hook" ]]; then
    echo "yay-review: cannot find aur-review (looked in $here and /usr/lib/aur-reviewer)" >&2
    exit 1
fi

exec yay --editmenu --answeredit All --editor "$hook" "$@"
